# Copy this file to .env and update the values below

# Application Settings
APP_NAME=Lavalust
APP_KEY=
APP_ENV=development

# Database Configuration
DB_DRIVER=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=
DB_PREFIX=

# For API
JWT_SECRET=
REFRESH_TOKEN_KEY=
# Public Web OAuth client ID only; no Google client secret is needed.
GOOGLE_CLIENT_ID=
# Email delivery remains disabled until a Resend key and verified sender are configured.
MAIL_PROVIDER=resend
MAIL_ENABLED=0
MAIL_API_KEY=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=CFABS
MAIL_APP_URL=http://127.0.0.1:5173
